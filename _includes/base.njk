<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} | thefunders.ca{% else %}thefunders.ca | Canadian Mortgage Broker | Free Financing Reports{% endif %}</title>
<meta name="description" content="{% if description %}{{ description }}{% else %}thefunders.ca helps Canadians navigate mortgages with clarity — first-time buyers, newcomers, refinancers, and investors. Get a free, instant financing report for any property, no signup required.{% endif %}">
<link rel="canonical" href="https://thefunders.ca{{ page.url }}">
<meta property="og:title" content="{% if title %}{{ title }} | thefunders.ca{% else %}thefunders.ca | Canadian Mortgage Broker{% endif %}">
<meta property="og:description" content="{% if description %}{{ description }}{% else %}Free instant financing reports, 100+ lenders, 48-hour pre-approval. A clearer path to homeownership for all Canadians.{% endif %}">
<meta property="og:url" content="https://thefunders.ca{{ page.url }}">
<meta property="og:type" content="website">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&display=swap" rel="stylesheet">
<style>
:root{
  --forest:#19231d;--forest-light:#24352c;--sage:#7fb069;--sage-glow:#9bc98a;--sage-faint:#e8f5e9;
  --cream:#fefaf3;--amber:#b8860b;--amber-light:#fff8e7;--ink:#1e293b;--ink-muted:#5a6b60;--border:#e2ddd0;
  --font-sans:'Inter',system-ui,sans-serif;--font-serif:'Playfair Display',Georgia,serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:var(--font-sans);background:var(--cream);color:var(--ink);line-height:1.6;overflow-x:hidden;}
.wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
a{color:inherit;}

/* NAV */
.nav{display:flex;align-items:center;justify-content:space-between;padding:26px 0;}
.logo{font-family:var(--font-sans);font-size:22px;display:flex;align-items:baseline;gap:2px;}
.logo .the{color:#9aa39a;font-weight:400;}
.logo .funders{color:var(--forest);font-weight:800;}
.logo .dot{width:7px;height:7px;background:var(--sage);border-radius:50%;margin-left:3px;align-self:flex-start;margin-top:6px;}
.nav-links{display:flex;gap:38px;align-items:center;}
.nav-links a{color:#4b5563;text-decoration:none;font-size:15px;font-weight:500;}
.nav-cta{background:var(--forest);color:#fff;padding:12px 26px;border-radius:100px;font-size:14px;font-weight:600;text-decoration:none;}

/* SHARED BUTTONS */
.btn{padding:15px 30px;border-radius:100px;font-family:var(--font-sans);font-size:14.5px;font-weight:700;cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:transform 0.2s ease;}
.btn:hover{transform:translateY(-2px);}
.btn-primary{background:var(--forest);color:#fff;}
.btn-secondary{background:#fff;color:var(--forest);border:1.5px solid var(--border);}

/* SHARED SECTION HEADER PATTERN (used across pages) */
.section{padding:100px 0;}
.section-label{display:inline-block;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--sage);margin-bottom:14px;}
.tool-eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--amber-light);border:1px solid #fde68a;color:#78350f;font-size:12px;font-weight:700;padding:7px 16px;border-radius:100px;margin-bottom:22px;text-transform:uppercase;letter-spacing:0.5px;}
.section-header{max-width:640px;margin:0 auto 56px;text-align:center;}
.section-header h2{font-family:var(--font-serif);font-size:clamp(30px,3.4vw,42px);font-weight:600;color:var(--forest);line-height:1.15;letter-spacing:-0.5px;margin-bottom:14px;}
.section-header h2 .italic{font-style:italic;color:var(--sage);}
.section-header p{font-size:16px;color:var(--ink-muted);}

/* FOOTER */
.site-footer{background:#fff;padding:64px 0 32px;border-top:1px solid var(--border);}
.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px;}
.footer-brand p{font-size:13.5px;color:var(--ink-muted);margin-top:14px;max-width:280px;line-height:1.7;}
.footer-col h5{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--ink-muted);margin-bottom:16px;}
.footer-col a{display:block;font-size:14px;color:var(--ink);text-decoration:none;margin-bottom:11px;}
.footer-bottom{border-top:1px solid var(--border);padding-top:24px;font-size:12.5px;color:var(--ink-muted);text-align:center;line-height:1.8;}

@media(max-width:900px){
  .nav-links{display:none;}
  .footer-grid{grid-template-columns:1fr 1fr;}
}
</style>
</head>
<body>

<div class="wrap">
  <nav class="nav">
    <div class="logo"><span class="the">the</span><span class="funders">funders</span><span class="dot"></span></div>
    <div class="nav-links">
      <a href="/#who-we-help">Who We Help</a>
      <a href="/#report-tool">Financing Report</a>
      <a href="/#how-it-works">How It Works</a>
      <a href="/#stories">Stories</a>
      <a href="/blog/">Blog</a>
      <a href="/#faq">FAQ</a>
    </div>
    <a href="/#contact" class="nav-cta">Book a Call</a>
  </nav>
</div>

{{ content | safe }}

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo"><span class="the">the</span><span class="funders">funders</span><span class="dot"></span></div>
        <p>{{ homepage.footer.description }}</p>
      </div>
      <div class="footer-col">
        <h5>Company</h5>
        {% for link in homepage.footer.company_links %}<a href="{{ link.url }}">{{ link.text }}</a>{% endfor %}
      </div>
      <div class="footer-col">
        <h5>Resources</h5>
        {% for link in homepage.footer.resource_links %}<a href="{{ link.url }}">{{ link.text }}</a>{% endfor %}
      </div>
      <div class="footer-col">
        <h5>Legal</h5>
        {% for link in homepage.footer.legal_links %}<a href="{{ link.url }}">{{ link.text }}</a>{% endfor %}
      </div>
    </div>
    <div class="footer-bottom">{{ homepage.footer.licensing }}<br>{{ homepage.footer.copyright }}</div>
  </div>
</footer>

</body>
</html>
