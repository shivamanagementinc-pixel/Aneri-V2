---
layout: base.njk
title: "For Realtors | The Funders Network"
description: "The Funders Network gives approved Realtors a property-first workspace for buyer reports, direct follow-up, engagement signals, marketing support, optional Open House QR campaigns, high-level Funders updates, and rewards visibility."
permalink: /for-realtors/index.html
---

<style>
.network-hero{padding:70px 0 58px;background:radial-gradient(circle at 84% 8%,rgba(127,176,105,.2),transparent 26rem),linear-gradient(145deg,#fefaf3,#f4f8f1)}
.network-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}.network-eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border:1px solid #b9d4b2;border-radius:100px;background:#edf6e9;color:#3c7137;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.network-hero h1{max-width:650px;margin:24px 0 18px;font-family:var(--font-serif);font-size:clamp(42px,5.4vw,70px);font-weight:600;line-height:1.03;letter-spacing:-1.4px;color:var(--forest)}.network-hero h1 em{font-style:italic;color:var(--sage)}.network-hero p{max-width:590px;color:var(--ink-muted);font-size:17px;line-height:1.65}.network-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.network-note{margin-top:18px;color:#65746a;font-size:12px;line-height:1.55}.network-preview{padding:21px;border:1px solid #d9e4d5;border-radius:20px;background:#fff;box-shadow:0 18px 52px rgba(25,35,29,.11)}.preview-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:15px;border-bottom:1px solid #edf0eb}.preview-top b{display:block;color:var(--forest);font-size:14px}.preview-top span{display:block;margin-top:3px;color:var(--ink-muted);font-size:11px}.preview-chip{padding:6px 9px;border-radius:99px;background:#edf6e9;color:#3d7039;font-size:10px;font-weight:800}.preview-property{margin:16px 0;padding:15px;border-radius:14px;background:#f5f8f3}.preview-property span{display:block;color:var(--ink-muted);font-size:10px}.preview-property b{display:block;margin-top:4px;color:var(--forest);font-size:16px}.preview-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.preview-kpis div{padding:11px;border:1px solid #e6ece4;border-radius:10px}.preview-kpis b{display:block;color:var(--forest);font-size:18px}.preview-kpis span{display:block;margin-top:3px;color:var(--ink-muted);font-size:9px}.preview-update{margin-top:12px;padding:12px;border-left:3px solid var(--sage);border-radius:8px;background:#f4faf2}.preview-update span{display:block;color:#4b7b43;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.preview-update b{display:block;margin-top:5px;color:var(--forest);font-size:12px}.preview-update small{display:block;margin-top:4px;color:var(--ink-muted);font-size:10px;line-height:1.4}
.network-section{padding:94px 0}.network-section.soft{background:#fff}.network-header{max-width:720px;margin:0 auto 46px;text-align:center}.network-header .label{display:inline-block;color:var(--sage);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.network-header h2{margin:12px 0 14px;color:var(--forest);font-family:var(--font-serif);font-size:clamp(33px,4vw,48px);font-weight:600;line-height:1.1}.network-header h2 em{font-style:italic;color:var(--sage)}.network-header p{color:var(--ink-muted);font-size:16px;line-height:1.6}.network-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.network-card{padding:25px;border:1px solid var(--border);border-radius:17px;background:#fff}.network-card .icon{display:grid;place-items:center;width:42px;height:42px;margin-bottom:17px;border-radius:12px;background:#edf6e9;color:#3e7438;font-size:20px;font-weight:900}.network-card h3{margin:0 0 9px;color:var(--forest);font-size:18px}.network-card p{margin:0;color:var(--ink-muted);font-size:14px;line-height:1.55}.workflow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.workflow-step{position:relative;padding:20px;border:1px solid #dce8d8;border-radius:15px;background:#f9fbf8}.workflow-step b{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--forest);color:#fff;font-size:11px}.workflow-step h3{margin:15px 0 6px;color:var(--forest);font-size:16px}.workflow-step p{margin:0;color:var(--ink-muted);font-size:12px;line-height:1.5}.privacy-wrap{display:grid;grid-template-columns:1fr 1fr;gap:20px}.privacy-panel{padding:27px;border-radius:18px;background:#f4faf2;border:1px solid #d6e6d1}.privacy-panel.dark{background:var(--forest);border-color:var(--forest)}.privacy-panel h3{margin:0 0 14px;color:var(--forest);font-family:var(--font-serif);font-size:25px}.privacy-panel.dark h3{color:#fff}.privacy-panel p{margin:0;color:var(--ink-muted);font-size:14px;line-height:1.6}.privacy-panel.dark p{color:#c9d9c8}.privacy-list{display:grid;gap:9px;margin-top:17px}.privacy-list div{display:flex;gap:9px;align-items:flex-start;color:var(--forest);font-size:13px;line-height:1.4}.privacy-list b{display:grid;place-items:center;flex:0 0 20px;height:20px;border-radius:50%;background:var(--sage);color:var(--forest);font-size:11px}.privacy-panel.dark .privacy-list div{color:#e5efe5}.privacy-panel.dark .privacy-list b{background:#34513b;color:#fff}.reward-panel{display:grid;grid-template-columns:1fr .9fr;gap:38px;align-items:center;padding:38px;border:1px solid #e6d5a8;border-radius:22px;background:linear-gradient(135deg,#fffdf6,#fbf4df)}.reward-panel h2{margin:10px 0;color:var(--forest);font-family:var(--font-serif);font-size:clamp(33px,4vw,47px);line-height:1.08}.reward-panel p{color:#6a654f;font-size:15px;line-height:1.6}.reward-tiers{display:grid;grid-template-columns:1fr 1fr;gap:9px}.reward-tier{padding:13px;border:1px solid #eadbae;border-radius:11px;background:rgba(255,255,255,.72)}.reward-tier b{display:block;color:#75530b;font-size:15px}.reward-tier span{display:block;margin-top:3px;color:#776f59;font-size:10px;line-height:1.35}.network-cta{padding:86px 0;text-align:center;background:var(--forest)}.network-cta h2{margin:0;color:#fff;font-family:var(--font-serif);font-size:clamp(36px,4.7vw,57px);line-height:1.08}.network-cta h2 em{color:var(--sage-glow);font-style:italic}.network-cta p{max-width:610px;margin:18px auto 28px;color:#c9d9c8;font-size:16px;line-height:1.6}.network-cta small{display:block;max-width:680px;margin:18px auto 0;color:#aebfaf;font-size:11px;line-height:1.5}@media(max-width:850px){.network-hero-grid,.privacy-wrap,.reward-panel{grid-template-columns:1fr}.network-grid{grid-template-columns:1fr 1fr}.workflow{grid-template-columns:1fr 1fr}}@media(max-width:560px){.network-hero{padding:46px 0}.network-grid,.workflow,.reward-tiers{grid-template-columns:1fr}.network-section{padding:66px 0}}
</style>

<section class="network-hero">
  <div class="wrap network-hero-grid">
    <div>
      <span class="network-eyebrow">{{ realtorPage.hero.eyebrow }}</span>
      <h1>{{ realtorPage.hero.headline }} <em>{{ realtorPage.hero.headline_accent }}</em></h1>
      <p>{{ realtorPage.hero.description }}</p>
      <div class="network-actions">
        <a class="btn btn-primary" href="{{ realtorPage.hero.primary_cta_url }}">{{ realtorPage.hero.primary_cta_text }} &rarr;</a>
        <a class="btn btn-secondary" href="{{ realtorPage.hero.secondary_cta_url }}">{{ realtorPage.hero.secondary_cta_text }}</a>
      </div>
      <p class="network-note">{{ realtorPage.hero.note }}</p>
    </div>
    <aside class="network-preview" aria-label="Property-first Funders Network workspace example">
      <div class="preview-top"><div><b>{{ realtorPage.preview.title }}</b><span>{{ realtorPage.preview.subtitle }}</span></div><span class="preview-chip">{{ realtorPage.preview.chip }}</span></div>
      <div class="preview-property"><span>{{ realtorPage.preview.property_label }}</span><b>{{ realtorPage.preview.property_name }}</b></div>
      <div class="preview-kpis">
        {% for metric in realtorPage.preview.metrics %}<div><b>{{ metric.number }}</b><span>{{ metric.label }}</span></div>{% endfor %}
      </div>
      <div class="preview-update"><span>{{ realtorPage.preview.update_label }}</span><b>{{ realtorPage.preview.update_title }}</b><small>{{ realtorPage.preview.update_detail }}</small></div>
    </aside>
  </div>
</section>

<section class="network-section">
  <div class="wrap">
    <div class="network-header"><span class="label">{{ realtorPage.overview.label }}</span><h2>{{ realtorPage.overview.headline }} <em>{{ realtorPage.overview.headline_accent }}</em></h2><p>{{ realtorPage.overview.description }}</p></div>
    <div class="network-grid">
      {% for feature in realtorPage.overview.features %}
      <article class="network-card"><div class="icon">{{ feature.icon }}</div><h3>{{ feature.title }}</h3><p>{{ feature.description }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="network-section soft" id="network-how-it-works">
  <div class="wrap">
    <div class="network-header"><span class="label">{{ realtorPage.workflow.label }}</span><h2>{{ realtorPage.workflow.headline }} <em>{{ realtorPage.workflow.headline_accent }}</em></h2><p>{{ realtorPage.workflow.description }}</p></div>
    <div class="workflow">
      {% for step in realtorPage.workflow.steps %}
      <article class="workflow-step"><b>{{ step.number }}</b><h3>{{ step.title }}</h3><p>{{ step.description }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="network-section">
  <div class="wrap privacy-wrap">
    <article class="privacy-panel"><h3>{{ realtorPage.privacy.visible_title }}</h3><p>{{ realtorPage.privacy.visible_description }}</p><div class="privacy-list">{% for item in realtorPage.privacy.visible_items %}<div><b>✓</b><span>{{ item }}</span></div>{% endfor %}</div></article>
    <article class="privacy-panel dark"><h3>{{ realtorPage.privacy.private_title }}</h3><p>{{ realtorPage.privacy.private_description }}</p><div class="privacy-list">{% for item in realtorPage.privacy.private_items %}<div><b>×</b><span>{{ item }}</span></div>{% endfor %}</div></article>
  </div>
</section>

<section class="network-section soft">
  <div class="wrap reward-panel">
    <div><span class="network-eyebrow">{{ realtorPage.rewards.eyebrow }}</span><h2>{{ realtorPage.rewards.headline }} <em>{{ realtorPage.rewards.headline_accent }}</em></h2><p>{{ realtorPage.rewards.description }}</p><p class="network-note">{{ realtorPage.rewards.note }}</p></div>
    <div class="reward-tiers">{% for tier in realtorPage.rewards.tiers %}<div class="reward-tier"><b>{{ tier.points }}</b><span>{{ tier.description }}</span></div>{% endfor %}</div>
  </div>
</section>

<section class="network-cta">
  <div class="wrap">
    <h2>{{ realtorPage.cta.headline }} <em>{{ realtorPage.cta.headline_accent }}</em></h2>
    <p>{{ realtorPage.cta.description }}</p>
    <a class="btn-light" href="{{ realtorPage.cta.button_url }}">{{ realtorPage.cta.button_text }} &rarr;</a>
    <small>{{ realtorPage.cta.legal }}</small>
  </div>
</section>
