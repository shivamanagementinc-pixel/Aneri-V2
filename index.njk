<script>
function toggleFaq(btn){
  const item = btn.parentElement;
  const wasOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
  if(!wasOpen) item.classList.add('open');
}

const affordSlider = document.getElementById('affordSlider');
const monthlyOut = document.getElementById('monthlyOut');
const powerOut = document.getElementById('powerOut');
const ASSUMED_RATE = {{ homepage.estimator.assumed_rate }};
const ASSUMED_YEARS = {{ homepage.estimator.assumed_amortization }};
const ASSUMED_DOWN_PCT = {{ homepage.estimator.assumed_down_percent }};

function calcPower(monthly){
  const rate = (ASSUMED_RATE/100)/12;
  const n = ASSUMED_YEARS*12;
  const loan = monthly*(Math.pow(1+rate,n)-1)/(rate*Math.pow(1+rate,n));
  const price = loan/(1 - ASSUMED_DOWN_PCT/100);
  return Math.round(price/1000)*1000;
}
function updateAfford(){
  const m = parseInt(affordSlider.value);
  monthlyOut.textContent = '$'+m.toLocaleString('en-CA');
  powerOut.textContent = '$'+calcPower(m).toLocaleString('en-CA');
}
if(affordSlider){
  affordSlider.addEventListener('input', updateAfford);
  updateAfford();
}
</script>
