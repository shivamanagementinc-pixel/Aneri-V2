---
layout: base.njk
title: "Leads Dashboard"
description: "Internal leads dashboard"
permalink: /leads/index.html
---

<style>
.leads-wrap{max-width:1100px;margin:40px auto;padding:0 24px;font-family:'Inter',system-ui,sans-serif;}
.leads-wrap h1{font-family:'Playfair Display',Georgia,serif;font-size:30px;color:#19231d;margin-bottom:20px;}
.login-gate{text-align:center;padding:80px 20px;}
.login-gate button{background:#19231d;color:#fff;border:none;padding:14px 30px;border-radius:100px;font-size:14px;font-weight:700;cursor:pointer;}
.leads-table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(25,35,29,.06);}
.leads-table th{background:#f8fafc;padding:12px 16px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#5a6b60;font-weight:700;border-bottom:1px solid #e2e8f0;}
.leads-table td{padding:12px 16px;font-size:13.5px;color:#1e293b;border-bottom:1px solid #f1f5f9;}
.leads-table tr:last-child td{border-bottom:none;}
.leads-table a{color:#7fb069;font-weight:700;text-decoration:none;}
.source-badge{font-size:10px;font-weight:700;text-transform:uppercase;padding:3px 8px;border-radius:100px;background:#e8f5e9;color:#14532d;}
.source-badge.manual{background:#fff8e7;color:#78350f;}
.empty-state,.error-state{text-align:center;padding:60px 20px;color:#5a6b60;}
</style>

<div class="leads-wrap">
  <h1>Leads Dashboard</h1>

  <div id="loginGate" class="login-gate">
    <p style="margin-bottom:20px;color:#5a6b60;">Please log in to view leads.</p>
    <button onclick="window.netlifyIdentity.open('login')">Log In</button>
  </div>

  <div id="leadsContent" style="display:none;">
    <p style="color:#5a6b60;margin-bottom:20px;font-size:13.5px;">Every report generated through Quick Generate or the manual form is logged here.</p>
    <table class="leads-table" id="leadsTable">
      <thead>
        <tr><th>Date</th><th>Buyer</th><th>Agent</th><th>MLS#</th><th>Address</th><th>Price</th><th>Source</th><th>Report</th></tr>
      </thead>
      <tbody id="leadsBody"></tbody>
    </table>
    <div id="emptyState" class="empty-state" style="display:none;">No leads logged yet.</div>
  </div>

  <div id="errorState" class="error-state" style="display:none;"></div>
</div>

<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
function fmtDate(iso){
  const d = new Date(iso);
  return d.toLocaleDateString('en-CA', { year:'numeric', month:'short', day:'numeric' }) + ' ' +
         d.toLocaleTimeString('en-CA', { hour:'2-digit', minute:'2-digit' });
}
function fmtPrice(p){
  return p ? '$' + Number(p).toLocaleString('en-CA') : '\u2014';
}

async function loadLeads(user){
  const loginGate = document.getElementById('loginGate');
  const leadsContent = document.getElementById('leadsContent');
  const errorState = document.getElementById('errorState');
  const leadsBody = document.getElementById('leadsBody');
  const emptyState = document.getElementById('emptyState');

  loginGate.style.display = 'none';

  try{
    const resp = await fetch('/.netlify/functions/list-leads', {
      headers: { 'Authorization': 'Bearer ' + user.token.access_token }
    });
    const data = await resp.json();

    if(!resp.ok){
      errorState.style.display = 'block';
      errorState.textContent = data.error || 'Failed to load leads.';
      return;
    }

    leadsContent.style.display = 'block';
    if(!data.leads || data.leads.length === 0){
      emptyState.style.display = 'block';
      return;
    }

    leadsBody.innerHTML = data.leads.map(lead => `
      <tr>
        <td>${fmtDate(lead.createdAt)}</td>
        <td>${lead.buyer || '\u2014'}</td>
        <td>${lead.agent || '\u2014'}</td>
        <td>${lead.mlsId || '\u2014'}</td>
        <td>${lead.address || '\u2014'}</td>
        <td>${fmtPrice(lead.price)}</td>
        <td><span class="source-badge ${lead.source==='manual'?'manual':''}">${lead.source||'quick-generate'}</span></td>
        <td><a href="/r/${lead.id}" target="_blank">View &rarr;</a></td>
      </tr>
    `).join('');
  }catch(err){
    errorState.style.display = 'block';
    errorState.textContent = 'Something went wrong loading leads.';
  }
}

window.netlifyIdentity.on('init', user => {
  if(user){
    loadLeads(user);
  }
});
window.netlifyIdentity.on('login', user => {
  loadLeads(user);
});
window.netlifyIdentity.init();
</script>
