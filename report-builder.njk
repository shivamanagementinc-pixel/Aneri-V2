<script>
function fmt(n){return '$'+Math.round(n).toLocaleString('en-CA');}
function calculateMortgage(P,annualRate,years){const r=annualRate/12;const n=years*12;if(r===0)return P/n;return P*(r*Math.pow(1+r,n))/(Math.pow(1+r,n)-1);}
function remainingBalance(P,annualRate,years,paymentsMade){const r=annualRate/12;const n=years*12;if(r===0)return P*(1-paymentsMade/n);return P*(Math.pow(1+r,n)-Math.pow(1+r,paymentsMade))/(Math.pow(1+r,n)-1);}
function getCMHC(dp){if(dp>=20)return 0;if(dp>=15)return 0.0280;if(dp>=10)return 0.0310;return 0.0400;}
function normalizePercent(v){v=Number(v);if(!v&&v!==0)return 0;return v<1?v*100:v;}
function ontarioLTT(price){let tax=0;if(price>2000000){tax+=(price-2000000)*0.025;price=2000000;}if(price>400000){tax+=(price-400000)*0.02;price=400000;}if(price>250000){tax+=(price-250000)*0.015;price=250000;}if(price>55000){tax+=(price-55000)*0.01;price=55000;}tax+=price*0.005;return tax;}
function fiveYearInterest(loanAmount,rate,amortYears){
  const monthly=calculateMortgage(loanAmount,rate,amortYears);
  const totalPaid=monthly*60;
  const principalPaid=loanAmount-remainingBalance(loanAmount,rate,amortYears,60);
  return totalPaid-principalPaid;
}
function generateRatesRows(rates,loanAmount,amortYears){return rates.map(r=>{const monthly=calculateMortgage(loanAmount,r.rate/100,amortYears);const isBest=r.isBest?' class="best-rate"':'';const bestClass=r.isBest?' best':'';const badge=r.isBest?'<span class="preferred-badge">thefunders.ca preferred</span>':'';const interest5=(typeof r.interest5yr==='number'&&!isNaN(r.interest5yr))?r.interest5yr:fiveYearInterest(loanAmount,r.rate/100,amortYears);return`<tr${isBest}><td>${r.term}${badge}</td><td class="rate-value${bestClass}">${r.rate.toFixed(2)}%</td><td><span class="bank-logo ${r.logo}">${r.lender}</span></td><td class="monthly-cell${bestClass}">${fmt(monthly)}</td><td>${fmt(interest5)}</td></tr>`;}).join('');}

function makeReport(){
  const status=document.getElementById('status');
  const price=Number(document.getElementById('f_price').value)||1250000;
  const dpPercent=Number(document.getElementById('f_dp').value)||20;
  const address=document.getElementById('f_address').value||'42 Willow Creek Drive, Toronto, ON';
  const isToronto=address.toLowerCase().includes('toronto');
  const buyer=document.getElementById('f_buyer').value||'The Buyer';
  const agent=document.getElementById('f_agent').value||'Your Realtor';
  const mls=document.getElementById('f_mls').value||'';
  const photo=document.getElementById('f_photo').value||'';
  const beds=document.getElementById('f_beds').value||'3';
  const baths=document.getElementById('f_baths').value||'2';
  const sqft=document.getElementById('f_sqft').value||'2,100';
  const type=document.getElementById('f_type').value||'Detached';
  const taxAnnual=Number(document.getElementById('f_tax').value)||9360;
  const condoMo=Number(document.getElementById('f_condo').value)||350;
  const estRent=Number(document.getElementById('f_rent').value)||3800;
  const basementRent=Number(document.getElementById('f_basement').value)||RATES.basementRent;

  const downPayment=price*(dpPercent/100);
  const cmhcRate=getCMHC(dpPercent);
  const cmhcAmount=cmhcRate>0?(price-downPayment)*cmhcRate:0;
  const loanAmount=price-downPayment+cmhcAmount;
  const amortYears=RATES.amortizationYears;
  const amortMonths=amortYears*12;

  const bestRate=RATES.rates.find(r=>r.isBest)||RATES.rates[2];
  const monthlyMortgage=calculateMortgage(loanAmount,bestRate.rate/100,amortYears);

  const monthlyTax=taxAnnual/12;
  const monthlyHeat=RATES.heatEstimate;
  const monthlyInsurance=RATES.insuranceEstimate;
  const monthlyUtilities=RATES.utilitiesEstimate;
  const monthlyCondo=condoMo;
  const monthlyTotal=monthlyMortgage+monthlyTax+monthlyCondo+monthlyInsurance+monthlyUtilities;

  const annualHousing=monthlyTotal*12;
  const incomeRequired=annualHousing/0.32;
  const gds=32.0;
  const tds=38.5;
  const stressRate=Math.max(bestRate.rate/100+0.02,normalizePercent(RATES.stressTestFloor)/100);
  const stressPayment=calculateMortgage(loanAmount,stressRate,amortYears);

  const lttOntario=ontarioLTT(price);
  const lttToronto=isToronto?ontarioLTT(price):0;
  const legalFees=2000,titleInsurance=450,inspection=650,appraisal=500,moving=2500,other=500;
  const closingCosts=lttOntario+lttToronto+legalFees+titleInsurance+inspection+appraisal+moving+other;

  const buyTotalMonthly=monthlyMortgage+monthlyTax+monthlyCondo+monthlyInsurance+monthlyUtilities;
  const rentTotalMonthly=estRent+RATES.tenantInsurance+RATES.utilitiesEstimate+RATES.parkingEstimate;

  const principal5yr=loanAmount-remainingBalance(loanAmount,bestRate.rate/100,amortYears,60);
  const apprPct=normalizePercent(RATES.appreciationRate);
  const sellPct=normalizePercent(RATES.sellingCostRate);
  const futureValue=price*Math.pow(1+apprPct/100,5);
  const appreciation5yr=futureValue-price;
  const sellingCosts=futureValue*(sellPct/100);
  const netWealth=principal5yr+appreciation5yr-sellingCosts;
  const rent5yrTotal=rentTotalMonthly*12*5;

  const netCarryingCost=buyTotalMonthly-basementRent;
  const rentDiff=rentTotalMonthly-netCarryingCost;
  const tenantPrincipal=remainingBalance(loanAmount,bestRate.rate/100,amortYears,0)-remainingBalance(loanAmount,bestRate.rate/100,amortYears,60);
  const tenantPrincipal5yr=tenantPrincipal*(basementRent/buyTotalMonthly);

  const fiveYearFixed=RATES.rates.find(r=>r.term==='5-Year Fixed');
  const bestSaveVs5yr=fiveYearFixed?Math.round(calculateMortgage(loanAmount,fiveYearFixed.rate/100,amortYears)-monthlyMortgage):130;

  let html=document.getElementById('tpl').innerHTML;
  html=html.replace(/__BUYER_NAME__/g,buyer)
  .replace(/__ADDRESS__/g,address)
  .replace(/__MLS__/g,mls)
  .replace(/__PHOTO__/g,photo)
  .replace(/__PRICE_FMT__/g,fmt(price))
  .replace(/__PRICE_RAW__/g,price)
  .replace(/__BEST_RATE_DECIMAL__/g,(bestRate.rate/100))
  .replace(/__AMORT_MONTHS__/g,amortMonths)
  .replace(/__CLOSING_RAW__/g,Math.round(closingCosts))
  .replace(/__BEDS__/g,beds)
  .replace(/__BATHS__/g,baths)
  .replace(/__SQFT__/g,sqft)
  .replace(/__TYPE__/g,type)
  .replace(/__DATE__/g,new Date().toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric'}))
  .replace(/__AGENT_NAME__/g,agent)
  .replace(/__DP__/g,dpPercent)
  .replace(/__DP_FMT__/g,fmt(downPayment))
  .replace(/__CMHC__/g,cmhcAmount>0?fmt(cmhcAmount)+' added to mortgage':'$0 (avoided!)')
  .replace(/__CMHC_CLASS__/g,cmhcAmount>0?'':'sage')
  .replace(/__CMHC_SUB__/g,cmhcAmount>0?'Added to mortgage principal':'Avoided with 20%+ down')
  .replace(/__CASH_CLOSE__/g,fmt(downPayment+closingCosts))
  .replace(/__LOAN__/g,fmt(loanAmount))
  .replace(/__MONTHLY_MORT__/g,fmt(monthlyMortgage))
  .replace(/__MONTHLY_TOTAL__/g,fmt(monthlyTotal))
  .replace(/__INCOME__/g,fmt(incomeRequired))
  .replace(/__GDS__/g,gds.toFixed(1))
  .replace(/__TDS__/g,tds.toFixed(1))
  .replace(/__STRESS_RATE__/g,(stressRate*100).toFixed(2)+'%')
  .replace(/__STRESS_PAYMENT__/g,fmt(stressPayment))
  .replace(/__CLOSING__/g,fmt(closingCosts))
  .replace(/__LTT__/g,fmt(lttOntario+lttToronto))
  .replace(/__RATES_ROWS__/g,generateRatesRows(RATES.rates,loanAmount,amortYears))
  .replace(/__BEST_RATE_TERM__/g,bestRate.term)
  .replace(/__BEST_RATE__/g,bestRate.rate.toFixed(2))
  .replace(/__BEST_SAVE_VS_5YR__/g,bestSaveVs5yr)
  .replace(/__AMORT__/g,amortYears)
  .replace(/__TAX_MO__/g,fmt(monthlyTax))
  .replace(/__CONDO__/g,fmt(monthlyCondo))
  .replace(/__INS__/g,fmt(monthlyInsurance))
  .replace(/__UTIL__/g,fmt(monthlyUtilities))
  .replace(/__BUY_TOTAL__/g,fmt(buyTotalMonthly))
  .replace(/__RENT__/g,fmt(estRent))
  .replace(/__TENANT_INS__/g,fmt(RATES.tenantInsurance))
  .replace(/__PARK__/g,fmt(RATES.parkingEstimate))
  .replace(/__RENT_TOTAL__/g,fmt(rentTotalMonthly))
  .replace(/__PRINCIPAL_5YR__/g,fmt(principal5yr))
  .replace(/__APPREC__/g,apprPct)
  .replace(/__APPREC_5YR__/g,fmt(appreciation5yr))
  .replace(/__SELL_PCT__/g,sellPct)
  .replace(/__SELL_COST__/g,fmt(sellingCosts))
  .replace(/__NET_WEALTH__/g,fmt(netWealth))
  .replace(/__RENT_5YR__/g,fmt(rent5yrTotal))
  .replace(/__BASEMENT__/g,fmt(basementRent))
  .replace(/__NET_CARRY__/g,fmt(netCarryingCost))
  .replace(/__RENT_DIFF__/g,fmt(rentDiff))
  .replace(/__TENANT_PRINCIPAL__/g,fmt(tenantPrincipal5yr));

  const blob=new Blob([html],{type:'text/html'});
  const url=URL.createObjectURL(blob);
  window.open(url,'_blank');
  status.textContent='Report opened in a new tab. Print or save from there.';
}
</script>
