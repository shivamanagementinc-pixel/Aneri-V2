function parseNumber(str){
  if(!str) return null;
  const cleaned=String(str).replace(/[^0-9.\-]/g,'');
  const n=parseFloat(cleaned);
  return isNaN(n)?null:n;
}
function parseFirstNumber(str){
  if(!str) return null;
  const m=String(str).match(/[\d,]+(\.\d+)?/);
  if(!m) return null;
  return parseNumber(m[0]);
}
function averageOfRange(str){
  // handles "$2,700-$2,900" or "2,700 to 2,900" style ranges -> midpoint
  const nums=(String(str).match(/[\d,]+(\.\d+)?/g)||[]).map(parseNumber).filter(n=>n!==null);
  if(nums.length===0) return null;
  if(nums.length===1) return nums[0];
  return Math.round((nums[0]+nums[1])/2);
}
function looksLikeImageUrl(url){
  if(!url) return false;
  if(/\.(jpe?g|png|webp|gif|avif)(\?|$)/i.test(url)) return true;
  if(/images\.unsplash\.com|cloudinary|imgix|\/photos?\//i.test(url)) return true;
  return false;
}
function guessPropertyType(str){
  const s=String(str).toLowerCase();
  if(s.includes('condo')||s.includes('apartment')) return 'Condo';
  if(s.includes('town')||s.includes('row')) return 'Townhouse';
  if(s.includes('semi')) return 'Semi-Detached';
  if(s.includes('detach')) return 'Detached';
  return null;
}

function parsePastedData(){
  const raw=document.getElementById('f_pasteData').value;
  const resultEl=document.getElementById('parseResult');
  if(!raw.trim()){resultEl.innerHTML='<span class="missed">Paste some property data first.</span>';return;}

  // Split into lines, extract "label / value" pairs from tab, pipe, or colon-separated lines
  const lines=raw.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
  const pairs=[];
  lines.forEach(line=>{
    let parts=null;
    if(line.includes('\t')) parts=line.split('\t').map(s=>s.trim()).filter(Boolean);
    else if(line.startsWith('|')) parts=line.split('|').map(s=>s.trim()).filter(Boolean);
    else if(/^[A-Za-z][A-Za-z0-9 /.®#()$'-]{2,40}:\s*.+/.test(line)) parts=line.split(/:\s*/).map(s=>s.trim());
    if(parts&&parts.length>=2 && !/^-+$/.test(parts[0]) && !/^-+$/.test(parts[1])){
      pairs.push([parts[0].toLowerCase(), parts.slice(1).join(' ').trim()]);
    }
  });

  const findVal=(...keywords)=>{
    for(const [label,val] of pairs){
      if(keywords.some(k=>label.includes(k))) return val;
    }
    return null;
  };

  // Also scan the whole raw text for an "MLS® XXXXXXXX" style mention, in case it's in a heading, not a table row
  const mlsHeadingMatch=raw.match(/MLS\s*®?\s*[:#]?\s*([A-Z0-9]{6,12})/i);

  const found=[]; const missed=[]; const warnings=[];

  const address=findVal('address');
  if(address){document.getElementById('f_address').value=address;found.push('Address');} else missed.push('Address');

  const mls=findVal('mls')||((mlsHeadingMatch&&mlsHeadingMatch[1])||null);
  if(mls){document.getElementById('f_mls').value=mls.replace(/^MLS\s*®?\s*[:#]?\s*/i,'').trim();found.push('MLS#');} else missed.push('MLS#');

  const price=findVal('list price','asking price','price');
  const priceNum=parseFirstNumber(price);
  if(priceNum){document.getElementById('f_price').value=Math.round(priceNum);found.push('List Price');} else missed.push('List Price');

  const photo=findVal('photo','image');
  if(photo){
    document.getElementById('f_photo').value=photo;
    found.push('Photo URL');
    if(!looksLikeImageUrl(photo)){
      warnings.push('The photo value looks like a listing page, not a direct image link. Right-click the listing photo itself \u2192 "Copy image address" and paste that URL instead, or the photo will not display.');
    }
  } else missed.push('Photo URL');

  const beds=findVal('bed');
  const bedsNum=parseFirstNumber(beds);
  if(bedsNum!==null){document.getElementById('f_beds').value=bedsNum;found.push('Beds');} else missed.push('Beds');

  const baths=findVal('bath');
  const bathsNum=parseFirstNumber(baths);
  if(bathsNum!==null){document.getElementById('f_baths').value=bathsNum;found.push('Baths');} else missed.push('Baths');

  const sqft=findVal('sqft','sq ft','square f');
  if(sqft){
    const primarySqft=sqft.split('(')[0].trim();
    const sqftNum=parseFirstNumber(primarySqft);
    if(sqftNum) document.getElementById('f_sqft').value=sqftNum.toLocaleString('en-CA');
    found.push('Sqft');
  } else missed.push('Sqft');

  const type=findVal('type');
  if(type){
    const mapped=guessPropertyType(type);
    if(mapped){document.getElementById('f_type').value=mapped;found.push('Type');}
    else warnings.push('Property type "'+type+'" wasn\'t recognized \u2014 please pick the right one from the Type dropdown.');
  } else missed.push('Type');

  const tax=findVal('annual property tax','property tax','tax');
  const taxNum=parseFirstNumber(tax);
  if(taxNum){document.getElementById('f_tax').value=Math.round(taxNum);found.push('Annual Property Tax');} else missed.push('Annual Property Tax');

  const condo=findVal('condo','maint');
  if(condo){
    const condoNum=/none|n\/a|freehold/i.test(condo)?0:parseFirstNumber(condo);
    document.getElementById('f_condo').value=condoNum||0;
    found.push('Condo/Maint Fee');
  } else missed.push('Condo/Maint Fee');

  const rent=findVal('est. monthly rent','estimated rent','monthly rent','rent');
  if(rent){
    const rentNum=averageOfRange(rent);
    if(rentNum){document.getElementById('f_rent').value=rentNum;found.push('Est. Monthly Rent (averaged if a range)');}
  } else missed.push('Est. Monthly Rent');

  const basement=findVal('basement rent','basement');
  if(basement){
    const basementNum=/none|n\/a|no separate|\$0/i.test(basement)?0:averageOfRange(basement);
    document.getElementById('f_basement').value=basementNum||0;
    found.push('Basement Rent');
  } else missed.push('Basement Rent');

  let html='';
  if(found.length) html+='<div class="found">&#10003; Filled in: '+found.join(', ')+'.</div>';
  if(missed.length) html+='<div class="missed">Not found in pasted text (left as-is, please check manually): '+missed.join(', ')+'.</div>';
  warnings.forEach(w=>{html+='<span class="warn">&#9888; '+w+'</span>';});
  resultEl.innerHTML=html;
}


function generateRecommendation(buyer,bestRate,rates,loanAmount,amortYears,dpPercent,cmhcAmount,monthlyMortgage,price){
  const parts=[];
  const variableRate=rates.find(r=>/variable/i.test(r.term));
  const fixedIsBest=/fixed/i.test(bestRate.term);

  parts.push(`Based on today's rates and a ${dpPercent}% down payment, the <span class="rec-highlight">${bestRate.term} at ${bestRate.rate.toFixed(2)}%</span> is the strongest option available right now.`);

  if(variableRate && variableRate.term!==bestRate.term){
    const variableMonthly=calculateMortgage(loanAmount,variableRate.rate/100,amortYears);
    const diff=Math.round(variableMonthly-monthlyMortgage);
    if(fixedIsBest && diff>0){
      parts.push(`It's ${fmt(diff)}/month cheaper than the current ${variableRate.term}, with a locked-in payment for the full term.`);
    }else if(fixedIsBest){
      parts.push(`The ${variableRate.term} is priced close to this right now \u2014 worth discussing if some payment fluctuation is comfortable in exchange for potential savings.`);
    }else{
      parts.push(`This variable option is currently pricing lower than the leading fixed rates \u2014 worth considering for those comfortable with some payment movement.`);
    }
  }

  if(dpPercent<20 && cmhcAmount>0){
    parts.push(`At this down payment level, CMHC insurance of ${fmt(cmhcAmount)} is added to the mortgage \u2014 reaching 20% down would remove that cost entirely.`);
  }else if(dpPercent>=20){
    parts.push(`At ${dpPercent}% down, CMHC insurance is avoided altogether, keeping the loan amount \u2014 and monthly payment \u2014 as low as possible.`);
  }

  parts.push(`This is a starting point based on the numbers available; the right fit still depends on your plans and comfort with risk, which we're happy to walk through together.`);

  return parts.join(' ');
}

async function makeReport(existingWindow){
  const status=document.getElementById('status');
  const reportWindow=existingWindow||window.open('','_blank');
  if(reportWindow) reportWindow.document.write('<p style="font-family:sans-serif;padding:60px;text-align:center;color:#5a6b60;">Generating your report&hellip;</p>');
  const reportId=(crypto.randomUUID?crypto.randomUUID():(Date.now()+'-'+Math.random().toString(36).slice(2)));
  const reportUrl=window.location.origin+'/.netlify/functions/view-report?id='+reportId;
  const price=Number(document.getElementById('f_price').value)||1250000;
  const dpPercent=Number(document.getElementById('f_dp').value)||20;
  const address=document.getElementById('f_address').value||'42 Willow Creek Drive, Toronto, ON';
  const isToronto=address.toLowerCase().includes('toronto');
  const buyer=document.getElementById('f_buyer').value||'The Buyer';
  const agent=document.getElementById('f_agent').value||'Your Realtor';
  const mls=document.getElementById('f_mls').value||'';
  const photo=document.getElementById('f_photo').value||'';
  const beds=document.getElementById('f_beds').value||'3';
  const baths=document.getElementById('f_baths').value||'2';
  const sqft=document.getElementById('f_sqft').value||'2,100';
  const type=document.getElementById('f_type').value||'Detached';
  const taxAnnual=Number(document.getElementById('f_tax').value)||9360;
  const condoMo=Number(document.getElementById('f_condo').value)||350;
  const estRent=Number(document.getElementById('f_rent').value)||3800;
  const basementRent=Number(document.getElementById('f_basement').value)||RATES.basementRent;

  const downPayment=price*(dpPercent/100);
  const cmhcRate=getCMHC(dpPercent);
  const cmhcAmount=cmhcRate>0?(price-downPayment)*cmhcRate:0;
  const loanAmount=price-downPayment+cmhcAmount;
  const amortYears=RATES.amortizationYears;
  const amortMonths=amortYears*12;

  const bestRate=RATES.rates.find(r=>isBestRate(r))||RATES.rates[2];
  const monthlyMortgage=calculateMortgage(loanAmount,bestRate.rate/100,amortYears);
  const recommendationText=generateRecommendation(buyer,bestRate,RATES.rates,loanAmount,amortYears,dpPercent,cmhcAmount,monthlyMortgage,price);

  const monthlyTax=taxAnnual/12;
  const monthlyHeat=RATES.heatEstimate;
  const monthlyInsurance=RATES.insuranceEstimate;
  const monthlyUtilities=RATES.utilitiesEstimate;
  const monthlyCondo=condoMo;
  const monthlyTotal=monthlyMortgage+monthlyTax+monthlyCondo+monthlyInsurance+monthlyUtilities;

  const annualHousing=monthlyTotal*12;
  const incomeRequired=annualHousing/0.32;
  const gds=32.0;
  const tds=38.5;
  const stressRate=Math.max(bestRate.rate/100+0.02,normalizePercent(RATES.stressTestFloor)/100);
  const stressPayment=calculateMortgage(loanAmount,stressRate,amortYears);

  const lttOntario=ontarioLTT(price);
  const lttToronto=isToronto?ontarioLTT(price):0;
  const legalFees=2000,titleInsurance=450,inspection=650,appraisal=500,moving=2500,other=500;
  const closingCosts=lttOntario+lttToronto+legalFees+titleInsurance+inspection+appraisal+moving+other;

  const buyTotalMonthly=monthlyMortgage+monthlyTax+monthlyCondo+monthlyInsurance+monthlyUtilities;
  const rentTotalMonthly=estRent+RATES.tenantInsurance+RATES.utilitiesEstimate+RATES.parkingEstimate;

  const principal5yr=loanAmount-remainingBalance(loanAmount,bestRate.rate/100,amortYears,60);
  const apprPct=normalizePercent(RATES.appreciationRate);
  const sellPct=normalizePercent(RATES.sellingCostRate);
  const futureValue=price*Math.pow(1+apprPct/100,5);
  const appreciation5yr=futureValue-price;
  const sellingCosts=futureValue*(sellPct/100);
  const netWealth=principal5yr+appreciation5yr-sellingCosts;
  const rent5yrTotal=rentTotalMonthly*12*5;

  const netCarryingCost=buyTotalMonthly-basementRent;
  const rentDiff=rentTotalMonthly-netCarryingCost;
  const tenantPrincipal=remainingBalance(loanAmount,bestRate.rate/100,amortYears,0)-remainingBalance(loanAmount,bestRate.rate/100,amortYears,60);
  const tenantPrincipal5yr=tenantPrincipal*(basementRent/buyTotalMonthly);

  const fiveYearFixed=RATES.rates.find(r=>r.term==='5-Year Fixed');
  const bestSaveVs5yr=fiveYearFixed?Math.round(calculateMortgage(loanAmount,fiveYearFixed.rate/100,amortYears)-monthlyMortgage):130;

  let html=document.getElementById('tpl').innerHTML;
  html=html.replace(/__BUYER_NAME__/g,buyer)
  .replace(/__ADDRESS__/g,address)
  .replace(/__MLS__/g,mls)
  .replace(/__PHOTO__/g,photo)
  .replace(/__PRICE_FMT__/g,fmt(price))
  .replace(/__RECOMMENDATION_TEXT__/g,recommendationText)
  .replace(/__PRICE_RAW__/g,price)
  .replace(/__BEST_RATE_DECIMAL__/g,(bestRate.rate/100))
  .replace(/__AMORT_MONTHS__/g,amortMonths)
  .replace(/__CLOSING_RAW__/g,Math.round(closingCosts))
  .replace(/__BEDS__/g,beds)
  .replace(/__BATHS__/g,baths)
  .replace(/__SQFT__/g,sqft)
  .replace(/__TYPE__/g,type)
  .replace(/__DATE__/g,new Date().toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric'}))
  .replace(/__AGENT_NAME__/g,agent)
  .replace(/__DP__/g,dpPercent)
  .replace(/__DP_FMT__/g,fmt(downPayment))
  .replace(/__CMHC__/g,cmhcAmount>0?fmt(cmhcAmount)+' added to mortgage':'$0 (avoided!)')
  .replace(/__CMHC_CLASS__/g,cmhcAmount>0?'':'sage')
  .replace(/__CMHC_SUB__/g,cmhcAmount>0?'Added to mortgage principal':'Avoided with 20%+ down')
  .replace(/__CASH_CLOSE__/g,fmt(downPayment+closingCosts))
  .replace(/__LOAN__/g,fmt(loanAmount))
  .replace(/__MONTHLY_MORT__/g,fmt(monthlyMortgage))
  .replace(/__MONTHLY_TOTAL__/g,fmt(monthlyTotal))
  .replace(/__INCOME__/g,fmt(incomeRequired))
  .replace(/__GDS__/g,gds.toFixed(1))
  .replace(/__TDS__/g,tds.toFixed(1))
  .replace(/__STRESS_RATE__/g,(stressRate*100).toFixed(2)+'%')
  .replace(/__STRESS_PAYMENT__/g,fmt(stressPayment))
  .replace(/__CLOSING__/g,fmt(closingCosts))
  .replace(/__LTT__/g,fmt(lttOntario+lttToronto))
  .replace(/<tr class="rows-placeholder"><td colspan="5">__RATES_ROWS__<\/td><\/tr>/,generateRatesRows(RATES.rates,loanAmount,amortYears))
  .replace(/__BEST_RATE_TERM__/g,bestRate.term)
  .replace(/__BEST_RATE__/g,bestRate.rate.toFixed(2))
  .replace(/__BEST_SAVE_VS_5YR__/g,bestSaveVs5yr)
  .replace(/__AMORT__/g,amortYears)
  .replace(/__TAX_MO__/g,fmt(monthlyTax))
  .replace(/__CONDO__/g,fmt(monthlyCondo))
  .replace(/__INS__/g,fmt(monthlyInsurance))
  .replace(/__UTIL__/g,fmt(monthlyUtilities))
  .replace(/__BUY_TOTAL__/g,fmt(buyTotalMonthly))
  .replace(/__RENT__/g,fmt(estRent))
  .replace(/__TENANT_INS__/g,fmt(RATES.tenantInsurance))
  .replace(/__PARK__/g,fmt(RATES.parkingEstimate))
  .replace(/__RENT_TOTAL__/g,fmt(rentTotalMonthly))
  .replace(/__PRINCIPAL_5YR__/g,fmt(principal5yr))
  .replace(/__APPREC__/g,apprPct)
  .replace(/__APPREC_5YR__/g,fmt(appreciation5yr))
  .replace(/__SELL_PCT__/g,sellPct)
  .replace(/__SELL_COST__/g,fmt(sellingCosts))
  .replace(/__NET_WEALTH__/g,fmt(netWealth))
  .replace(/__RENT_5YR__/g,fmt(rent5yrTotal))
  .replace(/__BASEMENT__/g,fmt(basementRent))
  .replace(/__NET_CARRY__/g,fmt(netCarryingCost))
  .replace(/__RENT_DIFF__/g,fmt(rentDiff))
  .replace(/__TENANT_PRINCIPAL__/g,fmt(tenantPrincipal5yr))
  .replace(/__REPORT_URL__/g,reportUrl);

  // Save the report so it has a permanent, shareable link and shows up in
  // the leads dashboard. This shouldn't block opening the report even if
  // saving fails for some reason (e.g. a transient network blip).
  try{
    await fetch('/.netlify/functions/save-report',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        id:reportId, reportHtml:html, buyer, agent, mlsId:mls,
        address, price, source:(window.__reportSource||'manual'),
        agentEmail:(window.__agentEmail||''), agentPhone:(window.__agentPhone||'')
      })
    });
  }catch(e){
    console.warn('Could not save report for tracking/link purposes:',e);
  }

  const blob=new Blob([html],{type:'text/html'});
  const url=URL.createObjectURL(blob);
  if(reportWindow && !reportWindow.closed){
    reportWindow.location.href=url;
  }else{
    window.open(url,'_blank');
  }
  status.textContent='Report opened in a new tab. Print or save from there.';
}
</script>
