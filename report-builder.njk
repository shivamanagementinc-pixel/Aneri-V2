<style>
.builder-wrap{max-width:800px;margin:40px auto;padding:0 24px;font-family:var(--font-sans,'Inter',system-ui,sans-serif);}
.builder-wrap h1{font-family:var(--font-serif,'Playfair Display',Georgia,serif);font-size:32px;color:#19231d;margin-bottom:6px;}
.builder-wrap>p{color:#5a6b60;font-size:15px;margin-bottom:28px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
.form-group{display:flex;flex-direction:column;}
.form-group.full{grid-column:1/-1;}
.form-group label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#19231d;margin-bottom:6px;}
.form-group input,.form-group select{padding:12px 14px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:14px;font-family:inherit;background:#fff;color:#1e293b;}
.form-group input:focus,.form-group select:focus{outline:none;border-color:#7fb069;box-shadow:0 0 0 4px rgba(127,176,105,.12);}
.builder-actions{display:flex;gap:12px;flex-wrap:wrap;}
.btn-gen{background:#19231d;color:#fff;border:none;padding:14px 32px;border-radius:100px;font-size:14px;font-weight:700;cursor:pointer;}
.btn-gen:hover{background:#24352c;}
.btn-sec{background:#fff;color:#19231d;border:1.5px solid #e2e8f0;padding:14px 32px;border-radius:100px;font-size:14px;font-weight:700;cursor:pointer;}
.status{margin-top:16px;font-size:13px;color:#5a6b60;min-height:20px;}
@media(max-width:640px){.form-grid{grid-template-columns:1fr;}}
</style>

<div class="builder-wrap">
  <h1>Buyer Report Builder</h1>
  <p>Fill in the property details. A branded, print-ready report opens instantly in a new tab.</p>

  <div class="form-grid">
    <div class="form-group full"><label>Prepared For</label><input type="text" id="f_buyer" value="The Johnson Family"></div>
    <div class="form-group full"><label>Property Address</label><input type="text" id="f_address" value="42 Willow Creek Drive, Toronto, ON M4E 2X9"></div>
    <div class="form-group"><label>MLS#</label><input type="text" id="f_mls" value="W12345678"></div>
    <div class="form-group"><label>List Price ($)</label><input type="number" id="f_price" value="1250000"></div>
    <div class="form-group full"><label>Photo URL</label><input type="url" id="f_photo" value="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1200&h=400&fit=crop&q=80"></div>
    <div class="form-group"><label>Beds</label><input type="number" id="f_beds" value="3"></div>
    <div class="form-group"><label>Baths</label><input type="number" id="f_baths" value="2"></div>
    <div class="form-group"><label>Sqft</label><input type="text" id="f_sqft" value="2,100"></div>
    <div class="form-group"><label>Type</label><select id="f_type"><option selected>Detached</option><option>Semi-Detached</option><option>Townhouse</option><option>Condo</option></select></div>
    <div class="form-group"><label>Annual Property Tax ($)</label><input type="number" id="f_tax" value="9360"></div>
    <div class="form-group"><label>Monthly Condo / Maint ($)</label><input type="number" id="f_condo" value="350"></div>
    <div class="form-group"><label>Est. Monthly Rent ($)</label><input type="number" id="f_rent" value="3800"></div>
    <div class="form-group"><label>Basement Rent ($)</label><input type="number" id="f_basement" value="1650"></div>
    <div class="form-group"><label>Down Payment %</label><select id="f_dp"><option value="5">5%</option><option value="10">10%</option><option value="15">15%</option><option value="20" selected>20%</option><option value="25">25%</option><option value="30">30%</option></select></div>
    <div class="form-group full"><label>Realtor Name</label><input type="text" id="f_agent" value="Sarah Chen"></div>
    <div class="form-group full"><label>Realtor Photo URL (optional)</label><input type="url" id="f_agentPhoto" value=""></div>
  </div>

  <div class="builder-actions">
    <button class="btn-gen" onclick="makeReport()">Generate Report</button>
    <button class="btn-sec" onclick="document.querySelectorAll('input').forEach(i=>i.value='');document.getElementById('f_dp').value='20';">Clear</button>
  </div>
  <div class="status" id="status"></div>
</div>

<script>
const RATES = {{ rates | dump | safe }};
</script>

