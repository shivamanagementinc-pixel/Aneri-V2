<script>
  const slider=document.getElementById('dpSlider');
  const cmhcDisplay=document.getElementById('cmhcDisplay');
  const cmhcSub=document.getElementById('cmhcSub');
  const cashDisplay=document.getElementById('cashDisplay');
  const loanDisplay=document.getElementById('loanDisplay');
  const monthlyDisplay=document.getElementById('monthlyDisplay');
  const dpDisplay=document.getElementById('dpDisplay');

  const PRICE=__PRICE_RAW__;
  const RATE=__BEST_RATE_DECIMAL__;
  const AMORT_MONTHS=__AMORT_MONTHS__;
  const CLOSING_COSTS=__CLOSING_RAW__;

  function calcMort(P,rate,months){const r=rate/12;return P*(r*Math.pow(1+r,months))/(Math.pow(1+r,months)-1);}
  function cmhcRateFor(dp){if(dp>=20)return 0;if(dp>=15)return 0.0280;if(dp>=10)return 0.0310;return 0.0400;}
  function money(n){return '$'+Math.round(n).toLocaleString('en-CA');}

  function updateDP(){
    const dpPercent=parseInt(slider.value);
    const downPayment=PRICE*(dpPercent/100);
    const cRate=cmhcRateFor(dpPercent);
    const cAmount=cRate>0?(PRICE-downPayment)*cRate:0;
    const loanAmount=PRICE-downPayment+cAmount;
    const monthly=calcMort(loanAmount,RATE,AMORT_MONTHS);
    const totalCash=downPayment+CLOSING_COSTS;

    dpDisplay.textContent=dpPercent+'% — '+money(downPayment);
    cmhcDisplay.textContent=cAmount>0?money(cAmount)+' added to mortgage':'$0 (avoided!)';
    cmhcDisplay.className='dp-num '+(cAmount>0?'':'sage');
    if(cmhcSub) cmhcSub.textContent=cAmount>0?'Added to mortgage principal':'Avoided with 20%+ down';
    cashDisplay.textContent=money(totalCash);
    loanDisplay.textContent=money(loanAmount);
    monthlyDisplay.textContent=money(monthly);
  }
  if(slider){slider.addEventListener('input',updateDP);}

  const modal=document.getElementById('emailModal');
  const modalForm=document.getElementById('modalForm');
  const successMsg=document.getElementById('successMsg');
  const modalTitle=document.getElementById('modalTitle');
  const modalSubtitle=document.getElementById('modalSubtitle');
  const modalSubmitBtn=document.getElementById('modalSubmitBtn');
  const successTitle=document.getElementById('successTitle');
  const successBody=document.getElementById('successBody');
  let pendingAction='preapproval';

  const MODAL_COPY={
    preapproval:{
      title:'Get Pre-Approved',
      subtitle:"Tell us a bit about you and a mortgage specialist will follow up within 2 hours.",
      button:'Request Pre-Approval',
      successTitle:'Request Sent!',
      successBody:'Check your inbox. A mortgage specialist will follow up within 2 hours.'
    },
    print:{
      title:'Just One Quick Thing',
      subtitle:"Tell us a bit about you, then we'll open the print dialog so you can save this report as a PDF.",
      button:'Continue to Print',
      successTitle:null, // no success screen \u2014 goes straight to print
      successBody:null
    },
    email:{
      title:'Just One Quick Thing',
      subtitle:"Tell us a bit about you, then we'll open your email app with this report ready to send.",
      button:'Continue to Email',
      successTitle:null, // no success screen \u2014 goes straight to email
      successBody:null
    }
  };

  function openModal(action){
    pendingAction=action||'preapproval';
    const copy=MODAL_COPY[pendingAction];
    modalTitle.textContent=copy.title;
    modalSubtitle.textContent=copy.subtitle;
    modalSubmitBtn.textContent=copy.button;
    modal.classList.add('active');
    modalForm.style.display='block';
    successMsg.classList.remove('active');
    document.body.style.overflow='hidden';
  }
  function closeModal(){modal.classList.remove('active');document.body.style.overflow='';}
  function submitEmail(){
    const name=document.getElementById('senderName').value.trim();
    const email=document.getElementById('senderEmail').value.trim();
    if(!name||!email){alert('Please fill in your name and email.');return;}

    if(pendingAction==='print'){
      closeModal();
      window.print();
      return;
    }
    if(pendingAction==='email'){
      closeModal();
      emailReport();
      return;
    }

    // preapproval: show the success screen in-place
    const copy=MODAL_COPY.preapproval;
    successTitle.textContent=copy.successTitle;
    successBody.textContent=copy.successBody;
    modalForm.style.display='none';
    successMsg.classList.add('active');
  }
  modal.addEventListener('click',(e)=>{if(e.target===modal)closeModal();});
  document.addEventListener('keydown',(e)=>{if(e.key==='Escape')closeModal();});

  function emailReport(){
    const subject=encodeURIComponent('Your Personalized Financing Report \u2014 __ADDRESS__');
    const body=encodeURIComponent(
      'Hi,\n\n'+
      "Thanks for your interest in __ADDRESS__! I've put together a personalized financing report to help you understand exactly what it takes to make this home yours.\n\n"+
      'QUICK SNAPSHOT\n'+
      '--------------------------------\n'+
      'List Price             __PRICE_FMT__\n'+
      'Recommended Rate       __BEST_RATE__% (__BEST_RATE_TERM__)\n'+
      'Est. Monthly Payment   __MONTHLY_TOTAL__ (incl. tax, condo fees & insurance)\n'+
      'Income Required        __INCOME__/year\n'+
      '5-Year Wealth Gain     ~__NET_WEALTH__ (buying vs. renting)\n'+
      '--------------------------------\n\n'+
      "The full report covers your financing roadmap, a buy-vs-rent breakdown, rental income potential, and a closing cost estimate.\n\n"+
      "View or save the full report here:\n__REPORT_URL__\n\n"+
      "Happy to walk through any of this together whenever works for you \u2014 just reply to this email or give me a call.\n\n"+
      'Talk soon,\n'+
      '__AGENT_NAME__\n\n'+
      '--\n'+
      'The Funders Mortgage Team\n'+
      'info@thefunders.ca | 437-605-9024\n'+
      'FSRA Lic. M23001234'
    );
    window.location.href='mailto:?subject='+subject+'&body='+body;
  }
</script>
